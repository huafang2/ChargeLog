<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="6dp"
        android:right="4dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/tab_liquid_shadow" />
        </shape>
    </item>

    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/tab_liquid_start"
                android:endColor="@color/tab_liquid_end" />
            <stroke
                android:width="1dp"
                android:color="@color/tab_liquid_stroke" />
        </shape>
    </item>
</layer-list>

<resources>
    <!-- Base application theme (Dark) with NoActionBar -->
    <style name="Theme.ChargeLog" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ChargeLog.MaterialAlertDialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.ChargeLog.Activity</item>
    </style>
</resources>